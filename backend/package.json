{
  "name": "@comercialapp/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "check": "prisma generate && prisma validate && node --test --test-concurrency=1",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:bootstrap-manager": "node scripts/bootstrap-admin.js",
    "db:bootstrap-admin": "node scripts/bootstrap-admin.js",
    "db:promote-admin": "node scripts/promote-admin.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@xmldom/xmldom": "^0.9.12",
    "adm-zip": "^0.6.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "prisma": "^7.9.0"
  }
}
