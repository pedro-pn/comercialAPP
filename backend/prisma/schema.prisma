generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CommercialRole {
  ADMIN
  MANAGER
  SELLER
  VIEWER
}

enum CostEstimateMode {
  NOVA
  REVISAO
}

enum CostEstimateStatus {
  RASCUNHO
  SALVO
}

enum ProposalStatus {
  RASCUNHO
  FINALIZANDO
  FINALIZADA
  FALHA_INTEGRACAO
}

enum ProposalIntegrationStatus {
  PENDENTE
  SUCESSO
  ERRO
}

enum ProposalDocumentKind {
  COMERCIAL
  TECNICA
}

enum ProposalDocumentFormat {
  PDF
  DOCX
}

model User {
  id           String          @id @default(cuid())
  username     String          @unique
  name         String
  passwordHash String?
  microsoftTenantId String?
  microsoftObjectId String?
  microsoftEmail String?
  role         CommercialRole
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  sessions     Session[]
  apiCredentials ApiCredential[] @relation("ApiCredentialCreator")
  revokedApiCredentials ApiCredential[] @relation("ApiCredentialRevoker")
  createdEstimates  CostEstimate[]             @relation("EstimateCreator")
  updatedEstimates  CostEstimate[]             @relation("EstimateUpdater")
  createdProposals  Proposal[]                 @relation("ProposalCreator")
  updatedProposals  Proposal[]                 @relation("ProposalUpdater")
  soldProposals     Proposal[]                 @relation("ProposalSeller")
  registeredSalesConsultants SalesConsultant[]
  numberReservations ProposalNumberReservation[]

  @@unique([microsoftTenantId, microsoftObjectId])
}

model ApiCredential {
  id              String    @id @default(cuid())
  name            String
  selector        String    @unique
  tokenHash       String
  tokenLastFour   String
  scopeCode       String    @default("crm.events.write")
  createdByUserId String
  createdBy       User      @relation("ApiCredentialCreator", fields: [createdByUserId], references: [id])
  createdAt       DateTime  @default(now())
  expiresAt       DateTime?
  revokedAt       DateTime?
  revokedByUserId String?
  revokedBy       User?     @relation("ApiCredentialRevoker", fields: [revokedByUserId], references: [id])
  lastUsedAt      DateTime?
  useCount        Int       @default(0)

  @@index([createdAt])
  @@index([expiresAt, revokedAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model ProposalNumberingState {
  id             String   @id @default("singleton")
  seedValue      Int
  nextNumber     Int
  seededAt       DateTime @default(now())
  seededByUserId String
}

model ComercialSettings {
  id                   String   @id @default("singleton")
  sedeAddress          String   @default("")
  sedeFormattedAddress String?
  sedePlaceId          String?
  updatedAt            DateTime @updatedAt
  updatedByUserId      String?
  updatedByLabel       String?
}

model ProposalNumberReservation {
  number           Int       @id
  reservedByUserId String
  reservedBy       User      @relation(fields: [reservedByUserId], references: [id])
  reservedAt       DateTime  @default(now())
  firstUsedAt      DateTime?
  legacyFirstRevision Int?

  @@index([reservedByUserId, reservedAt])
}

model CostEstimate {
  id              String             @id @default(cuid())
  proposalCode    String
  revisionNumber  Int                @default(0)
  title           String
  mode            CostEstimateMode
  status          CostEstimateStatus @default(RASCUNHO)
  payload         Json
  totalCost       Decimal            @db.Decimal(14, 2)
  salePrice       Decimal            @db.Decimal(14, 2)
  marginPercent   Decimal            @db.Decimal(6, 2)
  createdByUserId String
  createdBy       User               @relation("EstimateCreator", fields: [createdByUserId], references: [id])
  updatedByUserId String?
  updatedBy       User?              @relation("EstimateUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  updatedByLabel  String?
  archivedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  versions        CostEstimateVersion[]
  proposals       Proposal[]

  @@unique([proposalCode, revisionNumber])
  @@index([createdByUserId, archivedAt, createdAt])
}

model CostEstimateVersion {
  id             String       @id @default(cuid())
  costEstimateId String
  costEstimate   CostEstimate @relation(fields: [costEstimateId], references: [id], onDelete: Cascade)
  payloadHash    String
  snapshot       Json
  createdAt      DateTime     @default(now())

  @@index([costEstimateId, createdAt])
}

model SalesConsultant {
  id              String   @id @default(cuid())
  name            String
  normalizedName  String?  @unique
  createdByUserId String?
  createdBy       User?    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  archivedAt      DateTime?
  proposals       Proposal[]
}

model Proposal {
  id                 String                    @id @default(cuid())
  proposalCode       String
  revisionNumber     Int                       @default(0)
  costEstimateId     String?
  costEstimate       CostEstimate?             @relation(fields: [costEstimateId], references: [id])
  clientName         String
  cnpj               String
  contact            String
  email              String
  site               String
  department         String?
  sellerUserId       String?
  seller             User?                     @relation("ProposalSeller", fields: [sellerUserId], references: [id])
  sellerConsultantId String?
  sellerConsultant   SalesConsultant?           @relation(fields: [sellerConsultantId], references: [id])
  sellerName         String
  estimatorName      String
  payload            Json
  totalValue         Decimal                   @db.Decimal(14, 2)
  status             ProposalStatus            @default(RASCUNHO)
  finalizedAt        DateTime?
  nectarStatus       ProposalIntegrationStatus @default(PENDENTE)
  nectarOpportunityId String?
  nectarPipelineId  String?
  nectarPipelineName String?
  nectarCompanyId   String?
  nectarContactId   String?
  nectarAttemptId   String?
  nectarAttemptAt   DateTime?
  sharepointStatus   ProposalIntegrationStatus @default(PENDENTE)
  sharepointFolder   String?
  sharepointAttemptId String?
  sharepointAttemptAt DateTime?
  sharepointError    String?
  crmApprovalStatus  String    @default("PENDENTE")
  crmOpportunityId   String?
  crmProjectId       String?
  crmApprovalSource  String?
  crmApprovalAt      DateTime?
  filtroStatus       String    @default("PENDENTE")
  filtroError        String?
  filtroDeliveredAt  DateTime?
  filtroAttemptId    String?
  filtroAttemptAt    DateTime?
  filtroAttempts     Int       @default(0)
  filtroNextRetryAt  DateTime?
  integrationError   String?
  createdByUserId    String
  createdBy          User                      @relation("ProposalCreator", fields: [createdByUserId], references: [id])
  updatedByUserId    String?
  updatedBy          User?                     @relation("ProposalUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  updatedByLabel     String?
  archivedAt         DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  documents          ProposalDocument[]
  attachments        ProposalAttachment[]
  crmEvents          CrmProposalEvent[]

  @@unique([proposalCode, revisionNumber])
  @@index([createdByUserId, archivedAt, createdAt])
  @@index([sellerUserId, createdAt])
  @@index([sellerConsultantId])
  @@index([status])
}

model CrmProposalEvent {
  id             String   @id @default(cuid())
  eventId        String   @unique
  proposalId     String
  proposal       Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  source         String
  opportunityId  String?
  approvalStatus String
  projectId      String?
  occurredAt     DateTime
  reason         String?
  receivedAt     DateTime @default(now())

  @@index([proposalId, occurredAt])
}

model ProposalDocument {
  id           String                 @id @default(cuid())
  proposalId   String
  proposal     Proposal               @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  generationId String
  payloadHash  String
  rendererHash String?
  kind         ProposalDocumentKind
  format       ProposalDocumentFormat
  storagePath  String
  byteSize     Int
  createdAt    DateTime               @default(now())

  @@unique([generationId, kind, format])
  @@index([proposalId, createdAt])
}

model ProposalAttachment {
  id              String   @id @default(cuid())
  proposalId      String
  proposal        Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  storagePath     String
  originalName    String
  byteSize        Int
  createdByUserId String
  createdAt       DateTime @default(now())

  @@index([proposalId, createdAt])
}

model ScopePhotoAsset {
  id               String   @id @default(uuid())
  assetKey         String   @unique
  contentType      String
  byteSize         Int
  fileName         String
  uploadedByUserId String
  createdAt        DateTime @default(now())

  @@index([uploadedByUserId, createdAt])
}
