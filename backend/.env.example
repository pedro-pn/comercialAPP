PORT=4300
HOST=127.0.0.1
DATABASE_URL=postgresql://comercial:change-me@127.0.0.1:5432/comercialapp?schema=public
# Set to the public HTTPS origin in production.
APP_ORIGIN=http://localhost:5174
COMERCIAL_DIR=./storage
NODE_ENV=development

# Login Microsoft Entra, separado da integração SharePoint.
ENTRA_LOGIN_ENABLED=off
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_PRIVATE_KEY_PATH=
ENTRA_CERT_SHA256_THUMBPRINT=
ENTRA_CLIENT_SECRET=

# Nectar CRM. "off" é o padrão; "fake" testa sem rede; "real" usa a API da empresa.
# O Nectar não oferece sandbox: use "real" somente após conferir os IDs e o token.
NECTAR_MODE=off
# Configurações > Integrações > Gerar Token. Nunca coloque o token no Git.
NECTAR_API_TOKEN=
# Lista de IDs dos funis autorizados, separada por vírgulas. Vazia impede envios.
NECTAR_PIPELINE_IDS=
# ID numérico do usuário responsável pelas oportunidades no Nectar.
NECTAR_RESPONSAVEL_ID=
NECTAR_PROJECT_FIELD=

# SharePoint/OneDrive: off, fake ou real. Em real, configure as credenciais
# de aplicativo e o destino da biblioteca. Comece por uma pasta de teste.
SHAREPOINT_MODE=off
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
SHAREPOINT_DRIVE_ID=
SHAREPOINT_SITE_ID=
SHAREPOINT_HOSTNAME=
SHAREPOINT_SITE_PATH=
SHAREPOINT_BASE_FOLDER=

# Google Maps: Geocoding, Routes e Places (New). A sede é definida na tela
# Configurações e não por variável de ambiente.
GOOGLE_MAPS_MODE=off
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAX_DIA=200
GOOGLE_MAPS_MAX_DIA_SUGESTOES=300

# Webhook legado Nectar. O token do Prisma é criado pela Central de API.
NECTAR_WEBHOOK_TOKEN=
# Compatibilidade com configurações antigas do webhook Nectar.
CRM_EVENT_TOKEN=
FILTROAPP_API_URL=
FILTROAPP_API_TOKEN=
