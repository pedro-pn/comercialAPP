# Use uma senha aleatória com caracteres seguros em URL, por exemplo: openssl rand -hex 24
COMERCIAL_DB_PASSWORD=replace-with-long-random-url-safe-password

# Integração com Nectar CRM. Copie os valores reais apenas para o seu .env.
# "off" desliga; "fake" simula sem rede; "real" escreve no Nectar de produção.
NECTAR_MODE=off
NECTAR_API_TOKEN=
# IDs dos funis permitidos, separados por vírgulas; vazio bloqueia o envio.
NECTAR_PIPELINE_IDS=
# ID numérico do usuário responsável pelas oportunidades.
NECTAR_RESPONSAVEL_ID=
# Nome exato do campo personalizado da oportunidade que contém o ID do projeto no FiltroAPP.
NECTAR_PROJECT_FIELD=

# SharePoint/OneDrive via Microsoft Graph. Em real, use uma pasta de teste primeiro.
SHAREPOINT_MODE=off
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Prefira o ID da biblioteca liberada para o aplicativo. Como alternativa, use
# SITE_ID ou HOSTNAME + SITE_PATH.
SHAREPOINT_DRIVE_ID=
SHAREPOINT_SITE_ID=
SHAREPOINT_HOSTNAME=
SHAREPOINT_SITE_PATH=
# Obrigatória em modo real; impede gravação na raiz da biblioteca.
SHAREPOINT_BASE_FOLDER=

# Cálculo de distância: chave restrita às APIs Geocoding, Routes e Places (New).
GOOGLE_MAPS_MODE=off
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAX_DIA=200
GOOGLE_MAPS_MAX_DIA_SUGESTOES=300

# Recepção dos eventos do CRM e entrega ao FiltroAPP.
CRM_EVENT_TOKEN=
FILTROAPP_API_URL=
FILTROAPP_API_TOKEN=
