# Copie para .env.staging na raiz. Use sempre:
# docker compose --env-file .env.staging -f docker-compose.staging.yml ...
# Projeto, banco, volumes e rede de staging são separados da produção.

# OBRIGATÓRIO: senha própria do PostgreSQL de staging, segura para uso em URL.
# Gere com: openssl rand -hex 24
# DATABASE_URL é montada pelo Compose; não precisa ser preenchida duas vezes.
STAGING_DB_PASSWORD=replace-with-long-random-url-safe-staging-password

# OBRIGATÓRIO: URL exata usada no navegador, com porta e sem barra final.
# Troque pelo IP/DNS da VPS: http://IP_DA_VPS:8087
STAGING_APP_ORIGIN=http://localhost:8087
# Porta livre no host; o Nginx do contêiner continua ouvindo em 80.
STAGING_HTTP_PORT=8087
# 0.0.0.0 permite acesso pela VPS. Para túnel SSH/proxy no host: 127.0.0.1.
STAGING_BIND_IP=0.0.0.0

# Login Microsoft está sempre desligado neste Compose. Não configure ENTRA_*.
# Crie o administrador local pelo comando db:bootstrap-admin (docs/STAGING.md).

# Conexões de saída com Nectar, FiltroAPP, SharePoint e Google Maps ficam
# desativadas no Compose. Não é necessário configurar credenciais de saída.
# Eventos do CRM Prisma já são recebidos em /api/integrations/crm/events.
# Entre com perfil Administrador e emita um token em /api-central (docs/STAGING.md).
# O token é próprio do banco de staging; não configure CRM_EVENT_TOKEN para o Prisma.

# Opt-in apenas para o receptor sandbox do Prisma
STAGING_PRISMA_API_URL=
STAGING_PRISMA_API_TOKEN=
