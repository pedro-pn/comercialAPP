# Adicionar ao Caddyfile do infra-proxy da VPS depois de apontar o DNS.
# O ComercialAPP roda em Docker rootless próprio e publica somente no gateway
# 172.17.0.1:8083. O infra-proxy já define host.docker.internal:host-gateway.
comercial.filtrovali.com.br {
	reverse_proxy host.docker.internal:8083
}
